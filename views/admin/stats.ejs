<%- include('_top') %>

<div class="toolbar">
  <span>Range:</span>
  <a class="btn btn-ghost btn-small" href="/admin/stats?days=7">7 days</a>
  <a class="btn btn-ghost btn-small" href="/admin/stats?days=30">30 days</a>
  <a class="btn btn-ghost btn-small" href="/admin/stats?days=90">90 days</a>
</div>

<div class="admin-panel">
  <h2>Page views — last <%= days %> days</h2>
  <div class="chart-bar">
    <% byDay.forEach(function(d){ 
      var max = Math.max.apply(null, byDay.map(function(x){return x.c;}).concat([1]));
      var h = Math.max(4, Math.round(d.c / max * 140));
    %>
      <div class="bar" style="height:<%= h %>px" title="<%= d.d %>: <%= d.c %>"><span><%= d.d.slice(5) %></span></div>
    <% }); %>
  </div>
  <% if (byDay.length === 0) { %><p>No data yet.</p><% } %>
</div>

<div class="admin-panel">
  <h2>Devices</h2>
  <% byDevice.forEach(function(d){ %><p><span class="badge"><%= d.device %></span> — <%= d.c %> views</p><% }); %>
  <% if (byDevice.length === 0) { %><p>No data yet.</p><% } %>
</div>

<div class="admin-panel">
  <h2>Popular pages</h2>
  <table class="admin-table">
    <% byPath.forEach(function(p){ %><tr><td><a href="<%= p.path %>" target="_blank"><%= p.path %></a></td><td><%= p.c %></td></tr><% }); %>
  </table>
</div>

<div class="admin-panel">
  <h2>Top referrers (traffic sources)</h2>
  <table class="admin-table">
    <% byRef.forEach(function(r){ %><tr><td style="word-break:break-all"><%= r.referrer %></td><td><%= r.c %></td></tr><% }); %>
  </table>
  <% if (byRef.length === 0) { %><p>No referrer data yet.</p><% } %>
</div>

<div class="admin-panel">
  <h2>Ad &amp; link clicks</h2>
  <table class="admin-table">
    <% clicks.forEach(function(c){ %><tr><td><span class="badge"><%= c.kind %></span> <%= c.label %></td><td><%= c.c %></td></tr><% }); %>
  </table>
  <% if (clicks.length === 0) { %><p>No clicks tracked yet.</p><% } %>
</div>

<%- include('_bottom') %>
