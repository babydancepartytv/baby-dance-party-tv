<%- include('_top') %>

<% if (msg === 'saved') { %><div class="msg-ok">✓ Saved.</div><% } %>
<% if (msg && msg.startsWith('synced-')) { %><div class="msg-ok">✓ Synced <%= msg.replace('synced-','') %> videos from YouTube.</div><% } %>
<% if (msg === 'sync-error') { %><div class="form-err">Sync failed — check YouTube settings (API key / channel ID).</div><% } %>

<div class="toolbar">
  <form action="/admin/videos/sync" method="post"><button class="btn btn-primary btn-small" type="submit">🔄 Sync from YouTube</button></form>
  <form action="/admin/videos" method="get"><input type="text" name="q" placeholder="Search videos…" value="<%= q %>"></form>
</div>

<div class="admin-panel">
<table class="admin-table">
  <tr><th>Video</th><th>Published</th><th>Views</th><th>Category / Featured</th><th></th></tr>
  <% videos.forEach(function(v){ %>
  <tr>
    <td>
      <img class="thumb" src="<%= v.thumbnail %>" alt="" loading="lazy"><br>
      <strong><%= v.title %></strong><br>
      <a href="<%= videoUrl(v) %>" target="_blank" style="font-size:.8rem">View page →</a>
    </td>
    <td><%= (v.published_at||'').slice(0,10) %></td>
    <td><%= v.view_count %></td>
    <td>
      <form action="/admin/videos/update" method="post">
        <input type="hidden" name="id" value="<%= v.id %>">
        <select name="category_id">
          <option value="">— None —</option>
          <% cats.forEach(function(c){ %>
            <option value="<%= c.id %>" <%= v.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
        <label style="display:block;margin-top:6px;font-weight:400">
          <input type="checkbox" name="featured" value="1" <%= v.featured ? 'checked' : '' %> style="width:auto"> ★ Featured
        </label>
        <button class="btn btn-ghost btn-small" type="submit" style="margin-top:6px">Save</button>
      </form>
    </td>
    <td><a href="https://www.youtube.com/watch?v=<%= v.video_id %>" target="_blank" rel="noopener">YouTube ↗</a></td>
  </tr>
  <% }); %>
</table>
<% if (videos.length === 0) { %><p>No videos yet. Click "Sync from YouTube".</p><% } %>
</div>

<%- include('_bottom') %>
