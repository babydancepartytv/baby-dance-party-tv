<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container">
  <div class="page-head"><h1>Categories</h1><p>Browse videos by topic</p></div>
  <div class="cat-grid">
    <% cats.forEach(function(c){ %>
    <a class="cat-card" href="/category/<%= c.slug %>">
      <span class="cat-card-icon">📁</span>
      <strong><%= c.name %></strong>
      <span class="cat-count"><%= c.video_count %> videos</span>
      <% if (c.description) { %><p><%= c.description %></p><% } %>
    </a>
    <% }); %>
  </div>
</main>

<%- include('partials/footer') %>
