<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container narrow">
  <div class="page-head"><h1><%= page.title %></h1></div>
  <div class="prose"><%- page.content %></div>
  <% if (showForm) { %>
  <form class="contact-form" action="/page/contact" method="post">
    <% if (req.query.sent) { %><p class="form-ok">✓ Message sent! We will get back to you soon.</p><% } %>
    <% if (req.query.error) { %><p class="form-err">Please fill in all fields with a valid email.</p><% } %>
    <label>Name<input type="text" name="name" required maxlength="100"></label>
    <label>Email<input type="email" name="email" required maxlength="150"></label>
    <label>Message<textarea name="message" rows="5" required maxlength="2000"></textarea></label>
    <button class="btn btn-primary" type="submit">Send Message</button>
  </form>
  <% } %>
</main>

<%- include('partials/footer') %>
