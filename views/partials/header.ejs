<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-logo">🍼</span>
      <span class="brand-text"><%= settings.site_title %></span>
    </a>
    <nav class="main-nav" id="mainNav">
      <a href="/">Home</a>
      <a href="/videos">Videos</a>
      <div class="nav-dropdown">
        <button class="nav-drop-btn" type="button">Categories ▾</button>
        <div class="nav-drop-menu">
          <% categories.forEach(function(c){ %>
            <a href="/category/<%= c.slug %>"><%= c.name %></a>
          <% }); %>
        </div>
      </div>
      <% (settings.nav_pages || []).forEach(function(p){ %>
        <a href="/page/<%= p.slug %>"><%= p.title %></a>
      <% }); %>
    </nav>
    <div class="header-actions">
      <form class="search-form" action="/search" method="get" role="search">
        <input type="search" name="q" placeholder="Search videos…" value="<%= typeof q !== 'undefined' ? q : '' %>" aria-label="Search videos">
        <button type="submit" aria-label="Search">🔍</button>
      </form>
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark/light mode">🌙</button>
      <a class="btn btn-subscribe" href="<%= settings.youtube_channel_url %>" target="_blank" rel="noopener" data-track="youtube" data-label="header-subscribe">▶ Subscribe</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Menu">☰</button>
    </div>
  </div>
  <div class="mobile-nav" id="mobileNav">
    <a href="/">Home</a>
    <a href="/videos">Videos</a>
    <% categories.forEach(function(c){ %>
      <a href="/category/<%= c.slug %>"><%= c.name %></a>
    <% }); %>
    <a href="<%= settings.youtube_channel_url %>" target="_blank" rel="noopener">▶ Subscribe on YouTube</a>
  </div>
</header>
<% if (ads.header) { %>
<div class="container"><%- include('ad', {slot:'header', code: ads.header}) %></div>
<% } %>
